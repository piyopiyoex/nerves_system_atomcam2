diff -ruN a/inc/FifoAudioCapture.h b/inc/FifoAudioCapture.h
--- a/inc/FifoAudioCapture.h	1970-01-01 09:00:00.000000000 +0900
+++ b/inc/FifoAudioCapture.h	2026-08-12 23:01:01.515844193 +0900
@@ -0,0 +1,41 @@
+/* ---------------------------------------------------------------------------
+** atomcam2: FIFO-based audio capture, ALSA-free.
+**
+** This board's control kernel has no ALSA drivers (OSS only), so
+** upstream's ALSACapture cannot be built here. atomcam2-aicap (a small
+** libimp/IMP_AI daemon, built with the vendor uClibc toolchain like
+** camd) captures the microphone continuously and writes raw S16_BE
+** mono PCM into a named pipe. This class just reads that pipe as a
+** DeviceInterface, so the existing generic V4L2DeviceSource /
+** StreamReplicator / UnicastServerMediaSubsession plumbing (already
+** used for video) can drive an "audio/L16" RTP subsession unchanged.
+**
+** -------------------------------------------------------------------------*/
+
+#pragma once
+
+#include <string>
+
+#include "DeviceInterface.h"
+
+class FifoAudioCapture : public DeviceInterface
+{
+	public:
+		static FifoAudioCapture* createNew(const std::string & path, int sampleRate, int channels);
+		virtual ~FifoAudioCapture();
+
+		virtual size_t         read(char* buffer, size_t bufferSize);
+		virtual int            getFd()          { return m_fd;         }
+		virtual unsigned long  getBufferSize()  { return m_bufferSize; }
+		virtual int            getSampleRate()  { return m_sampleRate; }
+		virtual int            getChannels()    { return m_channels;   }
+
+	protected:
+		FifoAudioCapture(int fd, int sampleRate, int channels, unsigned long bufferSize);
+
+	private:
+		int           m_fd;
+		int           m_sampleRate;
+		int           m_channels;
+		unsigned long m_bufferSize;
+};
