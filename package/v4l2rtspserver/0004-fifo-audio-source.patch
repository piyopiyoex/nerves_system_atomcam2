diff -ruN a/src/FifoAudioCapture.cpp b/src/FifoAudioCapture.cpp
--- a/src/FifoAudioCapture.cpp	1970-01-01 09:00:00.000000000 +0900
+++ b/src/FifoAudioCapture.cpp	2026-08-12 23:01:16.699739377 +0900
@@ -0,0 +1,90 @@
+/* ---------------------------------------------------------------------------
+** atomcam2: FIFO-based audio capture, ALSA-free. See FifoAudioCapture.h.
+** -------------------------------------------------------------------------*/
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
+
+#include "FifoAudioCapture.h"
+#include "logger.h"
+
+// atomcam2-aicap writes one IMP_AI frame (400 samples @ 8kHz = 50ms) per
+// write() call; read() below always returns exactly one such chunk so
+// every live555 "frame" is a fixed, known duration (steady RTP timestamps).
+#define FIFO_CHUNK_SAMPLES 400
+
+FifoAudioCapture* FifoAudioCapture::createNew(const std::string & path, int sampleRate, int channels)
+{
+	// O_NONBLOCK so open() does not block this constructor call forever
+	// if atomcam2-aicap has not started writing yet; poll for the writer
+	// instead, then drop back to blocking reads.
+	int fd = -1;
+	for (int tries = 0; tries < 50 && fd < 0; tries++)
+	{
+		fd = open(path.c_str(), O_RDONLY | O_NONBLOCK);
+		if (fd < 0)
+		{
+			if (errno != ENXIO)
+			{
+				LOG(ERROR) << "FifoAudioCapture: cannot open " << path << " : " << strerror(errno);
+				return NULL;
+			}
+			usleep(200000);
+		}
+	}
+	if (fd < 0)
+	{
+		LOG(ERROR) << "FifoAudioCapture: timed out waiting for a writer on " << path;
+		return NULL;
+	}
+
+	int flags = fcntl(fd, F_GETFL, 0);
+	fcntl(fd, F_SETFL, flags & ~O_NONBLOCK);
+
+	unsigned long bufferSize = (unsigned long)FIFO_CHUNK_SAMPLES * channels * 2; // 16-bit samples
+	LOG(NOTICE) << "FifoAudioCapture: " << path << " rate:" << sampleRate << " channels:" << channels << " chunk:" << bufferSize;
+	return new FifoAudioCapture(fd, sampleRate, channels, bufferSize);
+}
+
+FifoAudioCapture::FifoAudioCapture(int fd, int sampleRate, int channels, unsigned long bufferSize)
+	: m_fd(fd), m_sampleRate(sampleRate), m_channels(channels), m_bufferSize(bufferSize)
+{
+}
+
+FifoAudioCapture::~FifoAudioCapture()
+{
+	if (m_fd >= 0)
+	{
+		close(m_fd);
+	}
+}
+
+// Always returns a full bufferSize chunk (or an error): loops over
+// short reads, and rides out the writer restarting (read() returning 0
+// on EOF when atomcam2-aicap closes/reopens its end).
+size_t FifoAudioCapture::read(char* buffer, size_t bufferSize)
+{
+	size_t total = 0;
+	while (total < bufferSize)
+	{
+		ssize_t n = ::read(m_fd, buffer + total, bufferSize - total);
+		if (n > 0)
+		{
+			total += (size_t)n;
+		}
+		else if (n == 0)
+		{
+			// writer side closed; back off briefly, keep waiting for it
+			// to come back rather than treating this as a fatal error.
+			usleep(100000);
+		}
+		else if (errno != EINTR)
+		{
+			LOG(ERROR) << "FifoAudioCapture: read error " << strerror(errno);
+			return (size_t)-1;
+		}
+	}
+	return total;
+}
