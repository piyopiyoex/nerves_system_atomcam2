+// atomcam2: ALSA-free audio replicator. Reads raw S16_BE mono PCM from a
+// FIFO fed by atomcam2-aicap (a small libimp/IMP_AI daemon, see
+// package/atomcam2-aicap/) instead of an ALSA capture device -- this
+// board's control kernel has no ALSA drivers, only OSS. See
+// FifoAudioCapture.h and docs/20260812_RTSP_音声追加_提案書.md.
+StreamReplicator* V4l2RTSPServer::CreateFifoAudioReplicator(
+			const std::string& fifoPath, int sampleRate, int channels,
+			int queueSize, V4L2DeviceSource::CaptureMode captureMode) {
+	StreamReplicator* audioReplicator = NULL;
+	if (!fifoPath.empty())
+	{
+		LOG(NOTICE) << "Create FIFO audio Source..." << fifoPath;
+
+		FifoAudioCapture* audioCapture = FifoAudioCapture::createNew(fifoPath, sampleRate, channels);
+		if (audioCapture)
+		{
+			audioReplicator = DeviceSourceFactory::createStreamReplicator(this->env(), -1, audioCapture, queueSize, captureMode);
+			if (audioReplicator == NULL)
+			{
+				LOG(FATAL) << "Unable to create source for device " << fifoPath;
+				delete audioCapture;
+			}
+		}
+	}
+	return audioReplicator;
+}
